# Engine container (Railway / Fly; ops/scheduler.py). Web app env vars live in apps/web/.env.example.
# Supabase project URL and service_role key: upload scan output to the private `scan` bucket. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hour (UTC) for the daily backtest. Default 6.
BACKTEST_HOUR_UTC=
