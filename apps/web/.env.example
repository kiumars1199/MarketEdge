# Demo: no auth, no billing, tier forced to premium. Only `true` turns it on; unset = on for pnpm dev, OFF in a production build.
DEMO_MODE=true
# local = read JSON from DATA_DIR; github = `live` branch via the GitHub contents API; supabase = private bucket (production)
DATA_SOURCE=local
# Empty = ../../output (relative to apps/web). Tests and e2e use test/fixtures.
DATA_DIR=
# Only for DATA_SOURCE=github
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPO=   # owner/name of this GitHub repo
GITHUB_DATA_REF=live

# --- Lane O (ops) ---
# DATA_SOURCE above also takes `supabase`: private Storage bucket `scan` → GitHub `live` branch → last good copy.
# Shared with the accounts lane: server reads the bucket and checks the DB with these two.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin for links in emails, e.g. https://kismetodds.example (no trailing slash)
NEXT_PUBLIC_SITE_URL=
# Vercel Cron bearer secret for /api/alerts/run and /api/settle/run (openssl rand -hex 32)
CRON_SECRET=
# /api/health turns 503 when a remote scan is older than this many minutes
HEALTH_MAX_DATA_AGE_MIN=30
# Errors (Sentry); empty = off
NEXT_PUBLIC_SENTRY_DSN=
# Analytics (PostHog, cookieless); empty = off
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Alert email (Resend); empty = no email sent
RESEND_API_KEY=
EMAIL_FROM=   # Kismet <noreply@kismetodds.com>; replies go to support_email in config/site.json
# Signs one-click unsubscribe links (openssl rand -hex 32)
UNSUBSCRIBE_SECRET=
# Engine container only (Railway/Fly), not Vercel: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, BACKTEST_HOUR_UTC=6

# --- Lane L (accounts, billing) ---
# Supabase Auth: NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are in the Lane O block above.
# Anon (public) key: Supabase > Project settings > API. Empty URL or key = accounts off.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 1 = show "Continue with Google" on /login and /signup. Leave empty until the Google provider is enabled in
# Supabase (docs/setup-notes/lane-l.md §2), or the button 400s. Magic link always works. Redeploy after changing.
NEXT_PUBLIC_GOOGLE_AUTH=
# Not read: next.config sets the browser flag from DEMO_MODE (unset DEMO_MODE = off in a production build).
NEXT_PUBLIC_DEMO_MODE=
# Stripe (test keys first). Empty = pricing buttons show "Coming soon".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# Optional fixed Customer Portal login link (Payment Links mode); empty = a portal session per user.
STRIPE_PORTAL_URL=
# Dev/e2e only, ignored when NODE_ENV=production: Stripe SDK at the in-app mock, and the mock routes on.
STRIPE_API_BASE=
E2E_MOCK=
# Trading terms on /terms appear when KALSHI_TRADING_ENV (repo-root .env.example, Lane E+K) is set.

# --- Lane X (security) ---
# Upstash Redis (rate limits, trading nonce used-set). Upstash console > database > REST API. Empty = rate limits OFF
# (warning logged) and nonces kept per instance; set both in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Lane E+K (extension + Kalshi paper trading) ---
# "demo" turns on the paper-trading ticket against Kalshi's DEMO exchange. Leave empty in production.
KALSHI_TRADING_ENV=
# Comma-separated emails allowed to see the Trade ticket when DEMO_MODE=false.
TRADING_ALLOWLIST=
# 32+ random characters. Signs extension sign-in tokens and one-time order nonces. Required when DEMO_MODE=false.
EXT_SIGNING_SECRET=
# Chrome Web Store extension ID (empty = the pinned dev ID cgoaaiaghbckpalppklocajbdpoelmbd).
NEXT_PUBLIC_EXTENSION_ID=
# Optional, e2e only (apps/web/.env.local): a Kalshi DEMO key with read + write::trade, to run trading-paper against the real demo exchange.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=
KALSHI_DEMO_TICKER=
NEXT_PUBLIC_EXTENSION_STORE_URL=

# --- Lane C ---
# Kalshi combo price check in the combo tray (docs/18 §5). Off unless "true". Turn on only once Kalshi has
# granted market-data permission for this use. See docs/setup-notes/lane-c.md.
KALSHI_DATA_PERMISSION=

# --- Lane AD (admin dashboard) ---
# Server-only. Comma-separated emails that may open /admin (compared lowercase, exact match, verified Supabase
# sign-in required). Not secrets. Empty = no admins. Never NEXT_PUBLIC_. See docs/setup-notes/admin.md.
ADMIN_EMAILS=kismetodds@gmail.com,marcyamin10@gmail.com,kiumarsmomtaz@gmail.com
# true = an admin session must be Supabase MFA level aal2 (TOTP verified) for /admin and /api/admin (RT3-06). Empty =
# email + magic link only. The app has no TOTP enroll/verify screen yet, so turning this on today locks admins out:
# see docs/setup-notes/admin.md § MFA before setting it.
ADMIN_REQUIRE_MFA=
