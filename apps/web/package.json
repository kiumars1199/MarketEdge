{
  "name": "kismet-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:ops",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:js": "node scripts/perf/landing-js.mjs --route / --budget-kb 150",
    "e2e": "playwright test && playwright test -c playwright.paid.config.ts",
    "test:ops": "node --test \"../../ops/tests/*.test.mjs\"",
    "preflight": "node ../../ops/preflight.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/nextjs": "11.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "botid": "1.5.13",
    "minisearch": "7.2.0",
    "next": "^15.5.29",
    "posthog-js": "1.440.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.14",
    "@eslint/eslintrc": "3.3.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
