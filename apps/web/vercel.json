{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pwd; ls -la node_modules/.pnpm 2>/dev/null | grep -i picomatch; rm -rf node_modules && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/alerts/run", "schedule": "0 13 * * *" },
    { "path": "/api/settle/run", "schedule": "30 7 * * *" },
    { "path": "/api/lifecycle/run", "schedule": "41 15 * * *" }
  ]
}
