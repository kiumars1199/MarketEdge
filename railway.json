{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "engine/Dockerfile",
    "watchPatterns": ["engine/**", "pipeline/**", "ops/**", "config/**", "railway.json"]
  },
  "deploy": {
    "startCommand": "python ops/scheduler.py",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
